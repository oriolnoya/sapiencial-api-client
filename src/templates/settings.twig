{% import "_includes/forms" as forms %}

{{ forms.autosuggestField({
  label: 'Sapiencial API Base URL',
  instructions: 'Ex: https://your-sapiencial-site.com',
  id: 'baseUrl',
  name: 'baseUrl',
  value: settings.baseUrl,
  suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
  label: 'Sapiencial API Token (Bearer)',
  id: 'apiToken',
  name: 'apiToken',
  value: settings.apiToken,
  suggestEnvVars: true
}) }}

{{ forms.textField({
  label: 'Default Site',
  id: 'defaultSite',
  name: 'defaultSite',
  value: settings.defaultSite
}) }}

{{ forms.textField({
  label: 'Timeout (seconds)',
  id: 'timeoutSeconds',
  name: 'timeoutSeconds',
  type: 'number',
  value: settings.timeoutSeconds,
  min: 1,
  max: 120
}) }}

<hr>

<div class="field">
  <div class="heading">
    <label>{{ 'API Connection Test' }}</label>
    <div class="instructions"><p>Run a quick API request and view a detailed log output.</p></div>
  </div>
  <div class="input ltr" data-sapiencial-connection-test>
    <button type="button" class="btn" data-role="test-btn">Test connection</button>
    <span class="light" style="margin-left:8px;" data-role="status"></span>
    <pre style="margin-top:10px; padding:10px; background:#f8f8f8; border:1px solid #ddd; border-radius:4px; max-height:240px; overflow:auto;" data-role="log">No test executed yet.</pre>
  </div>
</div>

{% js %}
(() => {
  const container = document.querySelector('[data-sapiencial-connection-test]');
  if (!container) {
    return;
  }

  const btn = container.querySelector('[data-role="test-btn"]');
  const statusEl = container.querySelector('[data-role="status"]');
  const logEl = container.querySelector('[data-role="log"]');
  const siteInput = document.querySelector('input[name="settings[defaultSite]"]');

  if (!btn || !statusEl || !logEl) {
    return;
  }

  const renderLog = (lines) => {
    logEl.textContent = Array.isArray(lines) && lines.length ? lines.join('\n') : 'No log output.';
  };

  btn.addEventListener('click', async (ev) => {
    ev.preventDefault();
    btn.disabled = true;
    statusEl.textContent = 'Running...';
    renderLog(['Running test...']);

    try {
      const site = siteInput ? siteInput.value : '';
      const {data} = await Craft.sendActionRequest('POST', 'sapiencial-api-client/settings/test-connection', {
        data: { site },
      });

      renderLog(data.log || []);
      if (data.success) {
        statusEl.textContent = 'OK';
      } else {
        statusEl.textContent = 'Failed';
      }
    } catch (error) {
      const message = error?.response?.data?.error || error?.message || 'Unknown error';
      renderLog([`Error: ${message}`]);
      statusEl.textContent = 'Failed';
    } finally {
      btn.disabled = false;
    }
  });
})();
{% endjs %}
