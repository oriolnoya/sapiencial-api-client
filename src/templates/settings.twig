{% import "_includes/forms" as forms %}

{{ forms.autosuggestField({
  label: 'Sapiencial API Base URL',
  instructions: 'Ex: https://your-sapiencial-site.com',
  id: 'baseUrl',
  name: 'baseUrl',
  value: settings.baseUrl,
  suggestEnvVars: true
}) }}

{{ forms.autosuggestField({
  label: 'Sapiencial API Token (Bearer)',
  id: 'apiToken',
  name: 'apiToken',
  value: settings.apiToken,
  suggestEnvVars: true
}) }}

{{ forms.textField({
  label: 'Default Site',
  id: 'defaultSite',
  name: 'defaultSite',
  value: settings.defaultSite
}) }}

{{ forms.textField({
  label: 'Timeout (seconds)',
  id: 'timeoutSeconds',
  name: 'timeoutSeconds',
  type: 'number',
  value: settings.timeoutSeconds,
  min: 1,
  max: 120
}) }}
